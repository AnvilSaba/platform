  "query": "SELECT d.user_id::text AS \"discord_user_id!\", d.last_known_username AS \"discord_name!\", m.uuid AS \"minecraft_uuid!\", m.last_known_name AS \"minecraft_name!\", l.linked_at AS \"linked_at!\" FROM mcguildlink.account_links l JOIN mcguildlink.discord_accounts d ON d.id = l.discord_account_id JOIN mcguildlink.minecraft_accounts m ON m.id = l.minecraft_account_id WHERE ($1::text IS NULL OR d.user_id = $1::text::numeric) AND ($2::uuid IS NULL OR m.uuid = $2) ORDER BY l.linked_at DESC, d.user_id, m.uuid",
